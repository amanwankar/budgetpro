rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: transactions
    // Document ID: auto-generated
    // Fields:
    //   - name: string (required, 1-100 chars)
    //   - amount: number (required)
    //   - category: string (required)
    //   - method: string (required)
    //   - date: string (required)
    //   - status: string (required)
    //   - uid: string (required, immutable) - Owner UID
    //   - createdAt: timestamp (required, immutable)
    //
    // Collection: goals
    // Document ID: auto-generated
    // Fields:
    //   - name: string (required, 1-100 chars)
    //   - target: number (required, positive)
    //   - current: number (required)
    //   - deadline: string (required)
    //   - uid: string (required, immutable) - Owner UID
    //   - createdAt: timestamp (required, immutable)
    //
    // Collection: budgets
    // Document ID: auto-generated
    // Fields:
    //   - category: string (required)
    //   - limit: number (required, positive)
    //   - month: string (required)
    //   - uid: string (required, immutable) - Owner UID
    //   - createdAt: timestamp (required, immutable)
    //
    // Collection: investments
    // Document ID: auto-generated
    // Fields:
    //   - type: string (required, enum: FD, EMI, SIP, RD)
    //   - name: string (required)
    //   - amount: number (required, positive)
    //   - dueDate: string (required)
    //   - imageUrl: string (optional)
    //   - interestRate: number (optional)
    //   - uid: string (required, immutable) - Owner UID
    //   - createdAt: timestamp (required, immutable)
    //
    // Collection: userStats
    // Document ID: userId (UID)
    // Fields:
    //   - manualBalance: number (optional)
    //   - manualIncome: number (optional)
    //   - manualExpense: number (optional)
    //   - manualSavings: number (optional)
    //   - savingStreak: number (optional)
    //   - lastDepositDate: timestamp (optional)
    //   - uid: string (required, immutable)
    //
    // Collection: gullakPots
    // Document ID: auto-generated
    // Fields:
    //   - name: string (required)
    //   - emoji: string (required)
    //   - target: number (required)
    //   - current: number (required)
    //   - lockDate: string (optional)
    //   - color: string (required)
    //   - contributors: list (required)
    //   - uid: string (required, immutable)
    //   - createdAt: timestamp (required, immutable)
    //
    // Collection: gullakDeposits
    // Document ID: auto-generated
    // Fields:
    //   - potId: string (required)
    //   - amount: number (required)
    //   - date: string (required)
    //   - method: string (required, enum: manual, auto)
    //   - note: string (optional)
    //   - uid: string (required, immutable)
    //   - createdAt: timestamp (required, immutable)
    //
    // Collection: roundUpHistory
    // Document ID: auto-generated
    // Fields:
    //   - date: string (required)
    //   - originalAmount: number (required)
    //   - roundedAmount: number (required)
    //   - savedAmount: number (required)
    //   - potId: string (required)
    //   - potName: string (required)
    //   - uid: string (required, immutable)
    //   - createdAt: timestamp (required, immutable)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "amanwankar18@gmail.com" && request.auth.token.email_verified == true));
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidTransaction(data) {
      return hasRequiredFields(['name', 'amount', 'category', 'method', 'date', 'status', 'uid', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.amount is number &&
             data.category is string &&
             data.method is string &&
             data.date is string &&
             data.status is string &&
             data.uid == request.auth.uid;
    }

    function isValidGoal(data) {
      return hasRequiredFields(['name', 'target', 'current', 'deadline', 'uid', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.target is number && data.target > 0 &&
             data.current is number &&
             data.deadline is string &&
             data.uid == request.auth.uid;
    }

    function isValidBudget(data) {
      return hasRequiredFields(['category', 'limit', 'month', 'uid', 'createdAt']) &&
             data.category is string &&
             data.limit is number && data.limit > 0 &&
             data.month is string &&
             data.uid == request.auth.uid;
    }

    function isValidInvestment(data) {
      return hasRequiredFields(['type', 'name', 'amount', 'dueDate', 'uid', 'createdAt']) &&
             data.type in ['FD', 'EMI', 'SIP', 'RD'] &&
             data.name is string && data.name.size() > 0 &&
             data.amount is number && data.amount > 0 &&
             data.dueDate is string &&
             data.uid == request.auth.uid;
    }

    function isValidUserStats(data) {
      return data.uid == request.auth.uid &&
             (!('manualBalance' in data) || data.manualBalance is number) &&
             (!('manualIncome' in data) || data.manualIncome is number) &&
             (!('manualExpense' in data) || data.manualExpense is number) &&
             (!('manualSavings' in data) || data.manualSavings is number) &&
             (!('savingStreak' in data) || data.savingStreak is number) &&
             (!('lastDepositDate' in data) || data.lastDepositDate is timestamp);
    }

    function isValidGullakPot(data) {
      return hasRequiredFields(['name', 'target', 'current', 'color', 'contributors', 'uid', 'createdAt']) &&
             data.name is string && data.name.size() > 0 &&
             data.target is number && data.target > 0 &&
             data.current is number &&
             data.color is string &&
             data.contributors is list &&
             data.uid == request.auth.uid;
    }

    function isValidGullakDeposit(data) {
      return hasRequiredFields(['potId', 'amount', 'date', 'method', 'uid', 'createdAt']) &&
             data.potId is string &&
             data.amount is number &&
             data.date is string &&
             data.method in ['manual', 'auto'] &&
             data.uid == request.auth.uid;
    }

    function isValidRoundUpHistory(data) {
      return hasRequiredFields(['date', 'originalAmount', 'roundedAmount', 'savedAmount', 'potId', 'potName', 'uid', 'createdAt']) &&
             data.date is string &&
             data.originalAmount is number &&
             data.roundedAmount is number &&
             data.savedAmount is number &&
             data.potId is string &&
             data.potName is string &&
             data.uid == request.auth.uid;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /transactions/{transactionId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidTransaction(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidTransaction(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner() || isAdmin();
    }

    match /goals/{goalId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidGoal(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidGoal(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner() || isAdmin();
    }

    match /budgets/{budgetId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidBudget(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidBudget(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner() || isAdmin();
    }

    match /investments/{investmentId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidInvestment(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidInvestment(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner() || isAdmin();
    }

    match /userStats/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUserStats(request.resource.data) && uidUnchanged();
      allow update: if isOwner(userId) && isValidUserStats(request.resource.data) && uidNotModified();
      allow delete: if isAdmin();
    }

    match /gullakPots/{potId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidGullakPot(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidGullakPot(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner() || isAdmin();
    }

    match /gullakDeposits/{depositId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidGullakDeposit(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidGullakDeposit(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner() || isAdmin();
    }

    match /roundUpHistory/{historyId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidRoundUpHistory(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidRoundUpHistory(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner() || isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
