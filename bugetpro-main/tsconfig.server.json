{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "outDir": "server-dist",
    "rootDir": ".",
    "noEmit": false
  },
  "include": [
    "server.ts"
  ]
}